{
  "manifest_version": 3,
  "name": "FokusWache",
  "version": "1.0.0",
  "description": "Gemeinsame Zeitlimits und Websperren mit dem lokalen FokusWache-Dienst.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fokuswache@local",
      "strict_min_version": "128.0"
    }
  }
}