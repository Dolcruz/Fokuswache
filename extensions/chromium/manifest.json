{
  "manifest_version": 3,
  "name": "FokusWache",
  "version": "1.0.0",
  "description": "Gemeinsame Zeitlimits und Websperren mit dem lokalen FokusWache-Dienst.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "incognito": "not_allowed"
}